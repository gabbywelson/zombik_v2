---
/**
 * THE /contact PAGE.
 *
 * A short note, the email address, and the social links from
 * src/content/site/author.md. There is deliberately no contact form: the site
 * has no server, so a form would need a third-party service.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAuthorData } from '../lib/content';

// The email address itself lives (encoded) in src/lib/contact-email.ts and is
// decoded in the browser by the <script> at the bottom of this file. Without
// JavaScript, visitors see the spelled-out hint below instead.
const author = await getAuthorData();
const socialLinks = author.socialLinks ?? [];
---

<BaseLayout title="Contact" description="How to get in touch with Chris Zombik.">
  <article class="contact-page reveal">
    <header class="contact-header">
      <h1>Get in touch</h1>
      <p>
        Chris would love to hear from you, whether it's about his writing, a project, an event, or
        just to say hello. The best way to reach him is by email:
      </p>
    </header>

    <p class="contact-email">
      <span data-contact-email>
        the first letter of his first name, followed by his last name, at gmail dot com
      </span>
    </p>

    {socialLinks.length > 0 && (
      <footer class="about-links">
        <h2>Elsewhere</h2>
        <ul>
          {socialLinks.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noreferrer noopener">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </footer>
    )}
  </article>
</BaseLayout>

<script>
  import { CONTACT_EMAIL, decodeEmail } from '../lib/contact-email';

  const target = document.querySelector('[data-contact-email]');

  if (target) {
    const address = decodeEmail(CONTACT_EMAIL);
    const link = document.createElement('a');
    link.href = `mailto:${address}`;
    link.textContent = address;
    target.replaceChildren(link);
  }
</script>
