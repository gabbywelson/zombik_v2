---
/**
 * A SINGLE WRITING ENTRY PAGE (/writing/<slug>).
 *
 * The square brackets in this filename mean "one page per writing entry": Astro
 * calls getStaticPaths() below to learn every slug, then builds one HTML page
 * for each. The slug is the Markdown filename without ".md".
 *
 * To change how a writing entry looks (where the date goes, whether the image shows,
 * etc.), edit the HTML at the bottom of this file. The styles live in
 * src/styles/global.css under "Article pages".
 */
import { render } from 'astro:content';
import TagList from '../../components/TagList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWritingBySlug, getWritingSlugs } from '../../lib/content';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const slugs = await getWritingSlugs();

  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const slug = Astro.params.slug ?? '';
const post = await getWritingBySlug(slug);

if (!post) {
  throw new Error(`Writing entry not found for slug: ${slug}`);
}
const { Content } = await render(post.entry);
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  socialImage={post.heroImage}
  socialImageAlt={post.heroImageAlt ?? post.title}
>
  <article class="post-page reveal">
    <header class="post-header">
      <p class="post-meta">
        <span>{formatDate(post.publishedAt)}</span>
      </p>

      <div class="post-title-block">
        <h1>{post.title}</h1>
      </div>
      <TagList tags={post.tags} hrefBase="/writing" />
    </header>

    <div class="rich-text"><Content /></div>
  </article>
</BaseLayout>
