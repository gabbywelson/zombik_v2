---
/**
 * SITE FOOTER — copyright line, social links, and design credit.
 * It appears on every page because src/layouts/BaseLayout.astro includes it.
 *
 * The social links here are written out by hand. The About and Contact pages
 * read theirs from src/content/site/author.md instead, so if you add or
 * change a link, update both places.
 */
const year = new Date().getFullYear();
---

